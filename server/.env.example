# Copy this file to .env and fill in your own values. Never commit .env.

# Neon: connection string WITH pooling (host contains "-pooler"). Used by the API.
# Change Neon's sslmode=require to verify-full so the server certificate is always checked.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Neon: connection string WITHOUT pooling. Used by Prisma for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Secret used to sign login tokens. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me"

# Frontend allowed to call the API (CORS). Comma-separated if more than one.
CLIENT_ORIGIN="http://localhost:5173"

PORT=3000
